# ==== BOT ====
# @BotFather dan oling
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
BOT_USERNAME=your_bot_username

# ==== ADMIN ====
# Sizning Telegram ID (@userinfobot dan)
ADMIN_IDS=123456789

# ==== DATABASE ====
POSTGRES_USER=truckbot
POSTGRES_PASSWORD=changeme_strong_password
POSTGRES_DB=truck_factory
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DB_URL=postgresql+asyncpg://truckbot:changeme_strong_password@localhost:5432/truck_factory

# ==== REDIS ====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# ==== APP ====
ENVIRONMENT=development
LOG_LEVEL=INFO
TIMEZONE=Asia/Tashkent

# ==== MEDIA ====
# Local uchun: ./media
# Docker uchun: /app/media
MEDIA_ROOT=./media
MAX_FILE_SIZE_MB=50
